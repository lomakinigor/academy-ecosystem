save-exact=false
engine-strict=true

# pnpm + Next.js 14: hoist Tailwind/PostCSS toolchain to top-level node_modules,
# иначе webpack ругается warnings'ами вида:
#   "Resolving 'tailwindcss/lib/index' ... doesn't lead to expected result"
# Next ищет эти пакеты по прямому пути, а pnpm складывает их в node_modules/.pnpm/.
public-hoist-pattern[]=*tailwindcss*
public-hoist-pattern[]=*autoprefixer*
public-hoist-pattern[]=*postcss*
