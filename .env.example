# Подключение к Postgres (Supabase или docker-compose).
# Скопируй в .env и заполни своими значениями. .env в gitignore.
#
# Supabase (Free tier):
#   1. Создай проект на https://supabase.com/dashboard
#   2. Connect → Session pooler → URI (порт 5432, не Transaction!)
#   3. Спецсимволы пароля percent-encode: # → %23, + → %2B, @ → %40
#
# Local docker-compose:
#   DATABASE_URL=postgresql://academy:academy@localhost:5432/academy?schema=public

DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Dev login (после pnpm --filter @academy/db db:seed):
#   email: svetlov@academy.ru | vp@academy.ru | director.msk@academy.ru
#          director.ekb@academy.ru | admin.chel@academy.ru | master.chel@academy.ru
#          master.ekb@academy.ru | listener.msk@academy.ru | listener.chel@academy.ru
#   password: academy123 (захэширован bcrypt в seed.ts)

# NextAuth secret. Сгенерировать: openssl rand -base64 32
AUTH_SECRET="replace-me-with-random-base64-string"