{
  "name": "@academy/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client \u0438 seed \u0434\u043b\u044f \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u0438",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "echo \"@academy/db: lint stub\" && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf .turbo node_modules/.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.10.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.11.0",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
