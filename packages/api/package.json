{
  "name": "@academy/api",
  "version": "0.1.0",
  "private": true,
  "description": "tRPC роутеры и Zod схемы Академии",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
