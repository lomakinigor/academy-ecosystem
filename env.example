# ── Academy Ecosystem — environment variables ─────────────────
# Переименуй этот файл в .env (или .env.local в apps/web) перед запуском.
# НЕ коммить реальные секреты.

# Database (PostgreSQL — поднимается через docker-compose у Agent DEVOPS)
DATABASE_URL="postgresql://academy:academy@localhost:5432/academy?schema=public"

# NextAuth.js v5 (заполнит Agent AUTH)
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Redis (BullMQ очереди)
REDIS_URL="redis://localhost:6379"

# Anthropic Claude API (контент-фабрика, Этап 3)
ANTHROPIC_API_KEY=""

# Supabase Storage (фото спикеров, баннеры)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Опционально: Sentry, Axiom (Observability)
SENTRY_DSN=""
AXIOM_TOKEN=""
